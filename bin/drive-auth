#!/usr/bin/env python3
"""One-time setup: mint a Drive refresh token for the Google account that owns
the shared root folder, and store it in Secrets Manager for the watcher Lambda.

    bin/drive-auth client_secret.json <secret-arn-or-name> [aws-profile]

client_secret.json: a "Desktop app" OAuth client from the GCP console
(APIs & Services > Credentials), with the Drive API enabled and the consent
screen published (a Testing-status app expires refresh tokens after 7 days).
"""

import http.server
import json
import os
import shutil
import subprocess
import sys
import tempfile
import urllib.parse
import urllib.request
import webbrowser

SCOPE = "https://www.googleapis.com/auth/drive"


def main(secret_file, secret_id, profile=None):
    if not shutil.which("aws"):
        sys.exit("aws CLI not found on PATH")
    with open(secret_file) as fh:
        client = json.load(fh).get("installed")
    if not client:
        sys.exit(f"{secret_file}: not a Desktop-app client secret (no 'installed' key)")
    code = {}

    class Catch(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            code.update(urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query))
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"Done. You can close this tab.")

        def log_message(self, *a):
            pass

    srv = http.server.HTTPServer(("127.0.0.1", 0), Catch)
    redirect = f"http://127.0.0.1:{srv.server_port}"
    url = "https://accounts.google.com/o/oauth2/v2/auth?" + urllib.parse.urlencode(dict(
        client_id=client["client_id"], redirect_uri=redirect, response_type="code",
        scope=SCOPE, access_type="offline", prompt="consent",
    ))
    print(f"Open in the browser of the Drive-owning account:\n\n{url}\n")
    webbrowser.open(url)
    while "code" not in code:
        srv.handle_request()

    body = urllib.parse.urlencode(dict(
        code=code["code"][0], client_id=client["client_id"], client_secret=client["client_secret"],
        redirect_uri=redirect, grant_type="authorization_code",
    )).encode()
    with urllib.request.urlopen("https://oauth2.googleapis.com/token", body) as r:
        tok = json.load(r)
    if "refresh_token" not in tok:
        sys.exit(f"token exchange failed: {tok.get('error')}: {tok.get('error_description', tok)}")
    creds = dict(client_id=client["client_id"], client_secret=client["client_secret"],
                 refresh_token=tok["refresh_token"])

    # via a 0600 temp file, not argv: argv is world-readable in the process list
    fd, path = tempfile.mkstemp(suffix=".json")
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(creds, fh)
        cmd = ["aws", "secretsmanager", "put-secret-value", "--secret-id", secret_id,
               "--secret-string", f"file://{path}"]
        if profile:
            cmd += ["--profile", profile]
        subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL, timeout=60)
    finally:
        os.unlink(path)
    print(f"stored refresh token in {secret_id}")


if __name__ == "__main__":
    if len(sys.argv) < 3:
        sys.exit(__doc__)
    main(*sys.argv[1:4])
